{
  "expo": {
    "name": "CampusRide",
    "slug": "campusride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "campusride",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07090d"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.campusride.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CampusRide needs your location to find rides near you.",
        "NSLocationAlwaysUsageDescription": "CampusRide needs background location to track your active ride.",
        "NSCameraUsageDescription": "CampusRide needs camera access to capture KYC documents.",
        "NSPhotoLibraryUsageDescription": "CampusRide needs photo access for profile and KYC uploads."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07090d"
      },
      "package": "com.campusride.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDEFAULT_PLACEHOLDER_MAPS_KEY"
        }
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow CampusRide to use your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CampusRide needs photo access for KYC uploads.",
          "cameraPermission": "CampusRide needs camera access for KYC documents."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "d9b5c608-aef0-49ed-bca2-e41b37f9dc72"
      }
    },
    "owner": "juhijain"
  }
}
