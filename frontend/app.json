{
  "expo": {
    "name": "CampusRide",
    "slug": "campusride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "campusride",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07090d"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.campusride.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CampusRide needs your location to find rides near you.",
        "NSLocationAlwaysUsageDescription": "CampusRide needs background location to track your active ride.",
        "NSCameraUsageDescription": "CampusRide needs camera access to capture KYC documents.",
        "NSPhotoLibraryUsageDescription": "CampusRide needs photo access for profile and KYC uploads."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07090d"
      },
      "package": "com.campusride.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow CampusRide to use your location."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#f5a623"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
